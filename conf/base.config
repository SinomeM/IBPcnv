/*
========================================================================================
    Base Process Configuration
========================================================================================
    Process-specific resource requirements based on the original SLURM directives
*/

process {
    
    // Default error strategy
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'
    
    // Process labels for resource allocation
    withLabel: process_low {
        cpus   = { check_max( 1, 'cpus' ) }
        memory = { check_max( 10.GB * task.attempt, 'memory' ) }
        time   = { check_max( 30.m * task.attempt, 'time' ) }
    }
    
    withLabel: process_medium {
        cpus   = { check_max( 1, 'cpus' ) }
        memory = { check_max( 10.GB * task.attempt, 'memory' ) }
        time   = { check_max( 10.h * task.attempt, 'time' ) }
    }
    
    withLabel: process_high {
        cpus   = { check_max( 1, 'cpus' ) }
        memory = { check_max( 20.GB * task.attempt, 'memory' ) }
        time   = { check_max( 10.h * task.attempt, 'time' ) }
    }
    
    // Process-specific resource requirements
    
    withName: PREPROCESS {
        cpus   = 2
        memory = 10.GB
        time   = 1.h
    }
    
    withName: SELECT_SNPS {
        cpus   = 2
        memory = 10.GB
        time   = 2.h
    }
    
    withName: CREATE_GC_MODEL {
        cpus   = 1
        memory = 10.GB
        time   = 30.m
    }
    
    withName: CREATE_PFB {
        cpus   = 1
        memory = 10.GB
        time   = 10.h
    }
    
    withName: SPLIT_BATCH_INTO_CHUNKS {
        cpus   = 1
        memory = 1.GB
        time   = 10.m
    }
    
    withName: CNV_CALLING {
        cpus   = 1
        memory = 5.GB
        time   = 15.h
    }
    
    withName: CLEAN_CNV {
        cpus   = 1
        memory = 5.GB
        time   = 1.h
    }
    
    withName: COMBINE_RESULTS {
        cpus   = 1
        memory = 20.GB
        time   = 10.h
    }
}
